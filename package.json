{
  "name": "turboforge",
  "private": true,
  "scripts": {
    "build": "turbo build --filter=!@app/web",
    "build:all": "turbo build",
    "build:diff": "turbo run build --filter=[...origin/main]",
    "build:web": "turbo build --filter=@app/web",
    "clean": "turbo clean",
    "coverage:upload": "node --experimental-strip-types ./tooling/scripts/upload-coverage.ts",
    "dev": "turbo dev",
    "debug:info": "node --experimental-strip-types ./tooling/scripts/debug-info.ts",
    "deps:update": "pnpm update -r --latest && pnpm biome migrate --write",
    "format": "biome check . --write",
    "gen": "node --experimental-strip-types ./node_modules/plop/bin/plop.js --plopfile tooling/generators/src/index.ts",
    "gen:icons": "node --experimental-strip-types ./tooling/scripts/generate-icons.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "postinstall": "node --experimental-strip-types ./tooling/scripts/postinstall.ts",
    "prepare": "husky",
    "rebrand": "node --experimental-strip-types ./tooling/scripts/rebrand.ts",
    "release": "pnpm build && changeset publish",
    "release:aliases": "node --experimental-strip-types ./tooling/scripts/publish-aliases.ts",
    "sync": "forge-sync",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "docs": "node --experimental-strip-types ./tooling/scripts/generate-api-docs.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tool/tsconfig": "workspace:*",
    "@turboforge/sync": "workspace:*",
    "@types/envinfo": "^7.8.4",
    "@types/node": "^26.6.4",
    "@types/sharp": "^0.32.0",
    "@vitest/coverage-v8": "^5.0.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "envinfo": "^7.21.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "plop": "^4.0.5",
    "sharp": "^0.35.5",
    "turbo": "^2.11.7",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  }
}
